{
  "version": 2,
  "builds": [
    {
      "src": "*.{html,css,js,png,jpg,ico,svg}",
      "use": "@vercel/static"
    },
    {
      "src": "api/[...path].js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|ico|svg))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
